# Copy this file to .env.local and fill in real values to activate each integration.
# The site works and forms submit successfully with none of these set —
# leads are simply logged server-side until you connect the real services.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# Generic CRM webhook. Every application, buyer list signup, contact
# form, and backup list submission is POSTed here as JSON. Point this at
# your CRM's inbound webhook (HubSpot, GoHighLevel, Follow Up Boss,
# Zapier/Make catch hook, etc.).
CRM_WEBHOOK_URL=

# Notification webhook (Slack incoming webhook, Zapier/Make, etc.) used
# to alert the assigned team member the moment a lead comes in.
LEAD_NOTIFICATION_WEBHOOK_URL=

# Public site URL, used for sitemap.xml, canonical URLs, and social
# sharing metadata.
NEXT_PUBLIC_SITE_URL=https://texasproperties4you.com
